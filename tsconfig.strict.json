{
  // Opt-in strict array access — adoption gradual del Bloque 3.a del análisis.
  //
  // Cada archivo listado en `include` ha sido **auditado**: revisado para que
  // todos los accesos `arr[i]` con `noUncheckedIndexedAccess: true` sean
  // semánticamente correctos (bounds-checked, regex-captured, post-filter
  // guarded). Las assertions `!` en estos archivos están documentadas inline.
  //
  // Workflow:
  //   1. Auditar un archivo: revisar cada `arr[i]`, añadir `!` o guard
  //      donde el bound sea provable por construcción.
  //   2. Añadir el archivo a `include` abajo.
  //   3. Verificar: `npm run typecheck:strict-audited` debe pasar.
  //   4. CI corre tanto `tsc --noEmit` como este config — regresión bloqueada
  //      en el subset auditado, sin imponer el flag global todavía.
  //
  // Cuando todos los archivos prod estén auditados, mover el flag a
  // tsconfig.json (global) y borrar este file.
  //
  // Estado: 23 archivos auditados (2026-05-18, expansión de 4 → 23). Cubre
  // todos los módulos puros del motor financiero — pricing helpers,
  // attributions, governance, customer360 aggregator, dealTimeline
  // aggregator, backtesting drift detector. Próximos candidatos por
  // prioridad: server/* routes (donde el bound viene del SQL), componentes
  // grandes (Calculator, Blotter), hooks.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "utils/pricing/nelsonSiegelSvensson.ts",
    "utils/pricing/interpolation.ts",
    "utils/pricing/shockPresets.ts",
    "utils/pricing/curveUtils.ts",
    "utils/pricing/bitemporal.ts",
    "utils/pricing/pricingConstants.ts",
    "utils/ruleMatchingEngine.ts",
    "utils/snapshotHash.ts",
    "utils/canonicalJson.ts",
    "utils/liquidityEngine.ts",
    "utils/creditRiskEngine.ts",
    "utils/customer360/csvImport.ts",
    "utils/customer360/relationshipAggregator.ts",
    "utils/customer360/crossBonusFromRelationship.ts",
    "utils/channels/tokenBucket.ts",
    "utils/channels/campaignMatcher.ts",
    "utils/governance/dossierSigning.ts",
    "utils/governance/escalationEvaluator.ts",
    "utils/attributions/attributionRouter.ts",
    "utils/attributions/attributionReporter.ts",
    "utils/attributions/chainBuilder.ts",
    "utils/backtesting/driftDetector.ts",
    "utils/dealTimeline/aggregator.ts"
  ]
}
